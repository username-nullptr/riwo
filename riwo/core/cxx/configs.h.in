// Riwo compiles Asio once in riwo.core so error categories remain identical
// across shared-library boundaries (notably on Windows).  CMake targets also
// publish the matching definition so it is present even when Asio is included
// before a Riwo header.
#if RIWO_USING_BOOST_ASIO
# if !defined(BOOST_ASIO_HEADER_ONLY) && \
	!defined(BOOST_ASIO_SEPARATE_COMPILATION) && !defined(BOOST_ASIO_DYN_LINK)
#  if RIWO_BUILD_STATIC
#   define BOOST_ASIO_SEPARATE_COMPILATION 1
#  else //RIWO_BUILD_STATIC
#   define BOOST_ASIO_DYN_LINK 1
#  endif //RIWO_BUILD_STATIC
# endif //BOOST...

#else //RIWO_USING_BOOST_ASIO
# if !defined(ASIO_HEADER_ONLY) && \
	!defined(ASIO_SEPARATE_COMPILATION) && !defined(ASIO_DYN_LINK)
#  if RIWO_BUILD_STATIC
#   define ASIO_SEPARATE_COMPILATION 1
#  else //RIWO_BUILD_STATIC
#   define ASIO_DYN_LINK 1
#  endif //RIWO_BUILD_STATIC
# endif //BOOST...
#endif //RIWO_USING_BOOST_ASIO

#if RIWO_IO_URING_SUPPORT

# if RIWO_USING_BOOST_ASIO
#  define BOOST_ASIO_HAS_IO_URING  1
#  define BOOST_ASIO_DISABLE_EPOLL  1

# else //RIWO_USING_BOOST_ASIO
#  define ASIO_HAS_IO_URING  1
#  define ASIO_DISABLE_EPOLL  1
# endif //RIWO_USING_BOOST_ASIO

#else //RIWO_IO_URING_SUPPORT

# if RIWO_USING_BOOST_ASIO
#  ifdef BOOST_ASIO_HAS_IO_URING
#   undef BOOST_ASIO_HAS_IO_URING
#  endif //BOOST_ASIO_HAS_IO_URING

#  ifdef BOOST_ASIO_DISABLE_EPOLL
#   undef BOOST_ASIO_DISABLE_EPOLL
#  endif //BOOST_ASIO_DISABLE_EPOLL

# else //RIWO_USING_BOOST_ASIO
#  ifdef ASIO_HAS_IO_URING
#   undef ASIO_HAS_IO_URING
#  endif //ASIO_HAS_IO_URING

#  ifdef ASIO_DISABLE_EPOLL
#   undef ASIO_DISABLE_EPOLL
#  endif //ASIO_DISABLE_EPOLL
# endif //RIWO_USING_BOOST_ASIO

#endif //RIWO_IO_URING_SUPPORT

